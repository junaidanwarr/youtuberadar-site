---
import Base from '../layouts/Base.astro';
import Notice from '../components/Notice.astro';
import Glyph from '../components/Glyph.astro';
import { offers, commerceLive } from '../lib/access';

const anyPlaceholder = offers.some((o) => o.placeholder);
const fmt = (o: (typeof offers)[number]) =>
  o.price
    ? new Intl.NumberFormat('en-US', { style: 'currency', currency: o.price.currency }).format(o.price.amount)
    : null;

const expect = [
  ['What you receive', 'The niche research files and editing templates included in the option you choose, with their sources and research dates.'],
  ['How you receive it', 'Digital access. The delivery method is confirmed when checkout goes live.'],
  ['What happens next', 'You plan, produce and publish on your own. There is no onboarding call, review or follow-up.'],
  ['What is not included', 'Coaching, video production, channel management, consulting, technical assistance and ongoing customer support.'],
  ['What is not promised', 'Views, subscribers, monetisation, earnings or any other result.'],
];
---

<Base
  title="Membership & Access"
  description="How access to YouTube Radar niches and editing templates is structured, what you receive, and what to expect."
>
  <section class="page-head">
    <div class="wrap">
      <nav class="crumbs" aria-label="Breadcrumb">
        <a href="/">Home</a><span aria-hidden="true">/</span><span aria-current="page">Access</span>
      </nav>
      <h1>Membership &amp; <span class="grad">access</span></h1>
      <p class="lede">
        Access is designed to be flexible: single resources, bundles, or membership to the full library.
      </p>
    </div>
  </section>

  <section class="wrap" style="padding-bottom:40px">
    {
      anyPlaceholder && (
        <Notice>
          <strong>Placeholder structure.</strong> The options below illustrate how access can be
          arranged. Names, contents and prices have not been decided, nothing here is on sale, and no
          payment can be taken on this page.
        </Notice>
      )
    }

    <div class="offers">
      {
        offers.map((o, i) => (
          <article class:list={['offer glass tilt reveal', o.kind === 'membership' && 'offer--key']} style={`--i:${i}`} data-tilt="4">
            <header>
              <span class="mono offer__kind">{o.kind.replace('-', ' ')}</span>
              {o.placeholder && <span class="pill pill--demo"><span class="dot" />Placeholder</span>}
            </header>
            <h2>{o.name}</h2>
            <p class="muted">{o.blurb}</p>
            <p class="offer__price">
              {fmt(o) ?? <span class="offer__tbd">Price to be announced</span>}
              {o.price?.interval && o.price.interval !== 'once' && <small> / {o.price.interval}</small>}
            </p>
            <ul>
              {o.includes.map((x) => <li><Glyph name="check" size={16} />{x}</li>)}
            </ul>
            <button class="btn btn--ghost" type="button" disabled data-offer={o.id}>
              {commerceLive && !o.placeholder ? 'Choose' : 'Not yet available'}
            </button>
          </article>
        ))
      }
    </div>
  </section>

  <section class="section" aria-labelledby="expect-title">
    <div class="wrap expect">
      <div class="reveal">
        <span class="eyebrow">What to expect</span>
        <h2 id="expect-title" style="margin-top:18px">Exactly what you get, and what you do not.</h2>
        <p class="lede" style="margin-top:18px">We provide the research-driven resources. You take control of execution.</p>
      </div>
      <dl class="expect__list reveal">
        {
          expect.map(([dt, dd]) => (
            <div>
              <dt>{dt}</dt>
              <dd>{dd}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </section>

  <section class="wrap" style="padding-bottom:80px;display:flex;flex-wrap:wrap;gap:12px">
    <a class="btn btn--primary" href="/niches/">Browse the niche library <span class="arrow" aria-hidden="true">→</span></a>
    <a class="btn btn--ghost" href="/faq/">Questions? Read the FAQ</a>
  </section>
</Base>

<style>
  .offers {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 18px;
    margin-top: 24px;
  }
  .offer {
    display: flex;
    flex-direction: column;
    gap: 14px;
    padding: 28px;
  }
  .offer--key {
    border-color: rgba(240, 170, 255, 0.45);
    background:
      radial-gradient(90% 60% at 50% 0%, rgba(214, 70, 255, 0.22), transparent 70%),
      linear-gradient(180deg, rgba(20, 25, 44, 0.8), rgba(10, 13, 24, 0.8));
  }
  .offer header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 8px;
  }
  .offer__kind {
    text-transform: uppercase;
    letter-spacing: 0.14em;
    font-size: 0.68rem;
    color: var(--accent-hi);
  }
  .offer h2 {
    font-size: 1.8rem;
    font-weight: 400;
  }
  .offer__price {
    font-family: var(--font-display);
    font-size: 2rem;
    font-weight: 300;
    padding: 14px 0;
    border-block: 1px solid var(--line);
  }
  .offer__tbd {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ev-estimate);
  }
  .offer ul {
    display: grid;
    gap: 10px;
    margin-bottom: 8px;
    flex: 1;
    align-content: start;
  }
  .offer li {
    display: flex;
    gap: 10px;
    font-size: 0.93rem;
    color: var(--ink-soft);
  }
  .offer li :global(svg) {
    flex: none;
    margin-top: 4px;
    color: var(--ev-verified);
  }
  .expect {
    display: grid;
    grid-template-columns: 1fr 1.3fr;
    gap: clamp(28px, 6vw, 80px);
    align-items: start;
  }
  .expect__list {
    margin: 0;
  }
  .expect__list div {
    display: grid;
    grid-template-columns: 180px 1fr;
    gap: 20px;
    padding: 20px 0;
    border-top: 1px solid var(--line);
  }
  .expect__list dt {
    font-family: var(--font-display);
    font-weight: 500;
  }
  .expect__list dd {
    margin: 0;
    color: var(--muted);
  }
  @media (max-width: 900px) {
    .offers,
    .expect {
      grid-template-columns: 1fr;
    }
  }
  @media (max-width: 560px) {
    .expect__list div {
      grid-template-columns: 1fr;
      gap: 6px;
    }
  }
</style>
