---
import Base from '../layouts/Base.astro';
---

<Base title="Page not found" description="That page is not on the radar." noindex>
  <section class="nf wrap">
    <div class="nf__radar" aria-hidden="true"></div>
    <span class="eyebrow">404 · No signal</span>
    <h1>Nothing on the radar here.</h1>
    <p class="lede">The page you were looking for has moved or never existed.</p>
    <div style="display:flex;flex-wrap:wrap;gap:12px;justify-content:center">
      <a class="btn btn--primary" href="/niches/">Explore premium niches</a>
      <a class="btn btn--ghost" href="/">Back to home</a>
    </div>
  </section>
</Base>

<style>
  .nf {
    min-height: 100svh;
    display: grid;
    align-content: center;
    justify-items: center;
    text-align: center;
    gap: 20px;
    padding-block: 140px 80px;
  }
  .nf h1 {
    font-size: clamp(2.2rem, 6vw, 4rem);
  }
  .nf__radar {
    width: 140px;
    height: 140px;
    border-radius: 50%;
    border: 1px solid var(--line-strong);
    background:
      conic-gradient(from 0deg, rgba(240, 170, 255, 0.5), transparent 25%),
      repeating-radial-gradient(circle, transparent 0 24%, rgba(240, 170, 255, 0.22) 24.500% 25.500%);
    animation: nf-spin 4s linear infinite;
    margin-bottom: 12px;
  }
  @keyframes nf-spin {
    to {
      transform: rotate(360deg);
    }
  }
</style>
