---
interface Props {
  size?: number;
}
const { size = 28 } = Astro.props;
---

<svg width={size} height={size} viewBox="0 0 32 32" fill="none" aria-hidden="true">
  <defs>
    <linearGradient id="lg-sweep" x1="16" y1="16" x2="28" y2="6" gradientUnits="userSpaceOnUse">
      <stop stop-color="#d646ff" stop-opacity="0"></stop>
      <stop offset="1" stop-color="#f0aaff"></stop>
    </linearGradient>
  </defs>
  <circle cx="16" cy="16" r="14" stroke="#f0aaff" stroke-opacity=".35" stroke-width="1.2"></circle>
  <circle cx="16" cy="16" r="8.5" stroke="#f0aaff" stroke-opacity=".55" stroke-width="1.2"></circle>
  <path d="M16 16 L27.5 7.6 A14 14 0 0 1 30 16 Z" fill="url(#lg-sweep)"></path>
  <path d="M13.4 12.2v7.6l6.6-3.8-6.6-3.8Z" fill="#ff2d2d"></path>
  <circle cx="24.4" cy="9.6" r="1.7" fill="#ff8fa3"></circle>
</svg>
