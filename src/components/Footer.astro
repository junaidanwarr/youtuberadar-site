---
import Logo from './Logo.astro';
const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="wrap">
    <div class="footer__top">
      <div class="footer__brand">
        <a href="/" class="footer__logo" aria-label="YouTube Radar home">
          <Logo size={30} />
          <span>YouTube <b>Radar</b></span>
        </a>
        <p class="footer__tag">Discover Smarter. Create Better.</p>
        <p class="muted">
          Premium YouTube niches. Professional editing resources. Independent execution.
        </p>
      </div>

      <nav aria-label="Explore">
        <h2 class="footer__h">Explore</h2>
        <ul>
          <li><a href="/niches/">Premium niches</a></li>
          <li><a href="/templates/">Editing templates</a></li>
          <li><a href="/access/">Membership &amp; access</a></li>
        </ul>
      </nav>

      <nav aria-label="Company">
        <h2 class="footer__h">Company</h2>
        <ul>
          <li><a href="/about/">About</a></li>
          <li><a href="/faq/">FAQ</a></li>
          <li><a href="/about/#standards">Research standards</a></li>
        </ul>
      </nav>
    </div>

    <div class="footer__model">
      <p>
        <strong>Self-service by design.</strong> YouTube Radar supplies research and templates. It does
        not provide coaching, video production, channel management, consulting or ongoing support. No
        views, earnings or outcomes are guaranteed.
      </p>
    </div>

    <div class="footer__bottom">
      <p>© {year} YouTube Radar</p>
      <p>
        An independent service. Not affiliated with, endorsed by or sponsored by YouTube or Google LLC.
        YouTube is a trademark of Google LLC.
      </p>
    </div>
  </div>
</footer>

<style>
  .footer {
    border-top: 1px solid var(--line);
    background: linear-gradient(180deg, transparent, rgba(214, 70, 255, 0.04));
    padding-block: 64px 36px;
    margin-top: 40px;
  }
  .footer__top {
    display: grid;
    grid-template-columns: 1.6fr 1fr 1fr;
    gap: 40px;
  }
  .footer__logo {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-family: var(--font-display);
    font-size: 1.15rem;
    font-weight: 300;
  }
  .footer__logo b {
    font-weight: 600;
  }
  .footer__tag {
    font-family: var(--font-display);
    font-size: 1.3rem;
    font-weight: 300;
    letter-spacing: -0.02em;
    margin: 18px 0 8px;
  }
  .footer__brand .muted {
    max-width: 36ch;
    font-size: 0.92rem;
  }
  .footer__h {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--muted);
    font-weight: 400;
    margin-bottom: 16px;
  }
  .footer nav li + li {
    margin-top: 10px;
  }
  .footer nav a {
    color: var(--ink-soft);
    font-size: 0.95rem;
    transition: color 0.2s;
  }
  .footer nav a:hover {
    color: var(--accent-hi);
  }
  .footer__model {
    margin-top: 48px;
    padding: 18px 20px;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    font-size: 0.88rem;
    color: var(--muted);
  }
  .footer__model strong {
    color: var(--ink-soft);
    font-weight: 600;
  }
  .footer__bottom {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 12px 32px;
    margin-top: 28px;
    font-size: 0.78rem;
    color: var(--faint);
  }
  .footer__bottom p:last-child {
    max-width: 62ch;
  }
  @media (max-width: 760px) {
    .footer__top {
      grid-template-columns: 1fr 1fr;
    }
    .footer__brand {
      grid-column: 1 / -1;
    }
  }
</style>
