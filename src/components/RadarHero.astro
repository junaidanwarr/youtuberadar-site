---
import { categories } from '../data/categories';
import { niches } from '../data/niches';
import { templates } from '../data/templates';
import Glyph from './Glyph.astro';

// Category names ride the radar as labelled signals.
const labelled = ['history', 'finance', 'true-crime', 'technology', 'health', 'science', 'documentary']
  .map((s) => categories.find((c) => c.slug === s)!)
  .filter(Boolean);

// Glass chips riding the light lines at the edges of the sky.
const chips = [
  { glyph: 'chart', cls: 'c1' },
  { glyph: 'column', cls: 'c2' },
  { glyph: 'atom', cls: 'c3' },
  { glyph: 'reel', cls: 'c4' },
];

const demoNiches = niches.filter((n) => n.status === 'demo').length;
const liveNiches = niches.length - demoNiches;
---

<section class="hero" aria-labelledby="hero-title">
  <div class="hero__scene" data-radar aria-hidden="true">
    <div class="hero__glow"></div>
    <!-- Static radar: shown until WebGL is live, and as the no-WebGL fallback. -->
    <div class="hero__fallback"></div>
    <canvas></canvas>
    <div class="hero__labels" data-radar-labels>
      {
        labelled.map((c) => (
          <span class="blip" data-blip>
            <i />
            {c.name}
          </span>
        ))
      }
    </div>
    <div class="hero__fade"></div>
    <div class="sky">
      <i class="sky__line l1"></i><i class="sky__line l2"></i><i class="sky__line l3"></i><i class="sky__line l4"></i>
      {chips.map((c) => <span class={`sky__chip ${c.cls}`}><Glyph name={c.glyph} size={18} /></span>)}
    </div>
  </div>

  <div class="wrap hero__content">
    <p class="pill hero__pill"><span class="hero__bolt" aria-hidden="true">⚡</span>Discover Smarter. Create Better.</p>
    <h1 id="hero-title">
      <span class="line"><span class="hgrad">Find Your Next</span></span>
      <span class="line"><span class="hgrad">YouTube Opportunity.</span></span>
    </h1>
    <p class="lede hero__lede">
      Explore premium YouTube niches backed by meaningful research and access professional editing
      templates designed to help you execute your content vision.
    </p>
    <div class="hero__cta">
      <a class="btn" href="/niches/">
        Explore Premium Niches <span class="arrow" aria-hidden="true">→</span>
      </a>
      <a class="btn btn--ghost" href="/templates/">Discover Editing Templates</a>
    </div>
  </div>

  <div class="wrap hero__hud-wrap">
    <dl class="hero__hud glass">
      <div>
        <dt>Categories on radar</dt>
        <dd>{categories.length}</dd>
      </div>
      <div>
        <dt>Niche records</dt>
        <dd>
          {liveNiches > 0 ? liveNiches : demoNiches}
          <small>{liveNiches > 0 ? 'published' : 'demo'}</small>
        </dd>
      </div>
      <div>
        <dt>Editing templates</dt>
        <dd>{templates.length} <small>demo</small></dd>
      </div>
      <div class="hero__hud-model">
        <dt>Model</dt>
        <dd class="hero__hud-text">We provide the resources. You execute the vision.</dd>
      </div>
    </dl>
  </div>
</section>

<script>
  const host = document.querySelector<HTMLElement>('[data-radar]');
  if (host) {
    const boot = () => import('../scripts/radar.ts').then((m) => m.mountRadar(host)).catch(() => {});
    // Let first paint and fonts land before pulling in the 3D bundle.
    'requestIdleCallback' in window ? requestIdleCallback(boot, { timeout: 1200 }) : setTimeout(boot, 200);
  }
</script>

<style>
  .hero {
    position: relative;
    min-height: max(100svh, 760px);
    display: flex;
    flex-direction: column;
    isolation: isolate;
    overflow: hidden;
  }
  .hero__scene {
    position: absolute;
    inset: 0;
    z-index: -1;
  }
  .hero__scene canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    opacity: 0;
    transition: opacity 1.4s ease;
  }
  .hero__scene.is-live canvas {
    opacity: 1;
  }
  .hero__glow {
    position: absolute;
    left: 50%;
    bottom: -38%;
    width: min(1500px, 150vw);
    aspect-ratio: 1.5;
    transform: translateX(-50%);
    background:
      radial-gradient(closest-side at 26% 46%, rgba(255, 40, 90, 0.2), transparent 70%),
      radial-gradient(closest-side at 74% 46%, rgba(60, 90, 255, 0.3), transparent 70%),
      radial-gradient(closest-side at 50% 62%, rgba(214, 70, 255, 0.28), transparent 72%);
    filter: blur(34px);
  }
  /* CSS-only radar for the fallback path */
  .hero__fallback {
    position: absolute;
    left: 50%;
    bottom: -52vmin;
    width: 120vmin;
    aspect-ratio: 1;
    transform: translateX(-50%);
    border-radius: 50%;
    background:
      conic-gradient(from 200deg, rgba(214, 70, 255, 0.28), transparent 22%),
      repeating-radial-gradient(circle, transparent 0 9.6%, rgba(240, 170, 255, 0.2) 9.8% 10%),
      radial-gradient(circle, rgba(214, 70, 255, 0.1), transparent 70%);
    mask-image: linear-gradient(#000 30%, transparent 55%);
    transition: opacity 1s ease;
  }
  .hero__scene.is-live .hero__fallback {
    opacity: 0;
  }
  .hero__fade {
    position: absolute;
    inset: auto 0 0 0;
    height: 26%;
    background: linear-gradient(transparent, var(--bg) 92%);
  }

  /* Thin light lines and glass chips crossing the sky */
  .sky {
    position: absolute;
    inset: 0;
    pointer-events: none;
    overflow: hidden;
  }
  .sky__line {
    position: absolute;
    height: 1px;
    width: 46vw;
    background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.34), transparent);
    transform-origin: 0 50%;
  }
  .sky__line.l1 {
    left: -4vw;
    top: 56%;
    transform: rotate(-38deg);
  }
  .sky__line.l2 {
    left: -6vw;
    top: 24%;
    transform: rotate(40deg);
    width: 30vw;
  }
  .sky__line.l3 {
    right: -30vw;
    top: 70%;
    transform: rotate(-70deg);
    transform-origin: 0 50%;
  }
  .sky__line.l4 {
    right: -34vw;
    top: 78%;
    transform: rotate(-42deg);
    width: 40vw;
  }
  .sky__chip {
    position: absolute;
    width: 44px;
    height: 44px;
    display: grid;
    place-items: center;
    border-radius: 50%;
    color: #e9ecff;
    border: 1px solid rgba(255, 255, 255, 0.22);
    background: rgba(18, 16, 34, 0.55);
    backdrop-filter: blur(10px);
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.16),
      0 8px 30px rgba(190, 80, 255, 0.25);
    animation:
      rise 1s var(--ease) 0.7s both,
      bob 7s ease-in-out 1.7s infinite alternate;
  }
  .sky__chip.c1 {
    left: 7.5vw;
    top: 43%;
  }
  .sky__chip.c2 {
    left: 15vw;
    top: 30%;
    animation-delay: 0.8s, 2.4s;
  }
  .sky__chip.c3 {
    right: 9vw;
    top: 36%;
    animation-delay: 0.9s, 1.2s;
  }
  .sky__chip.c4 {
    right: 4.5vw;
    top: 55%;
    animation-delay: 1s, 3s;
  }
  @keyframes bob {
    to {
      translate: 0 -10px;
    }
  }
  .hero__bolt {
    font-size: 0.8rem;
  }
  /* White headline with a soft tint at both ends */
  .hgrad {
    background: linear-gradient(90deg, #ffb3d9 0%, #fff 22%, #fff 76%, #c7b4ff 100%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .hero__labels {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }
  .blip {
    position: absolute;
    left: 0;
    top: 0;
    opacity: 0;
    display: inline-flex;
    align-items: center;
    gap: 7px;
    margin: -11px 0 0 12px;
    padding: 3px 10px;
    border-radius: 999px;
    border: 1px solid rgba(205, 170, 255, 0.3);
    background: rgba(6, 10, 26, 0.6);
    backdrop-filter: blur(8px);
    font-family: var(--font-mono);
    font-size: 0.66rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #dbe5ff;
    white-space: nowrap;
    will-change: transform, opacity;
  }
  .blip i {
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--accent2-hi);
    box-shadow: 0 0 8px var(--accent2);
  }

  .hero__content {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding-top: clamp(120px, 17vh, 190px);
  }
  .hero__pill {
    margin-bottom: 26px;
    animation: rise 1s var(--ease) both;
  }
  .hero h1 {
    max-width: 14ch;
  }
  .hero h1 .line {
    display: block;
    overflow: hidden;
    padding-bottom: 0.1em;
    margin-bottom: -0.1em;
  }
  .hero h1 .line > span {
    display: inline-block;
    animation: wipe 1.1s var(--ease) both;
  }
  .hero h1 .line:nth-child(2) > span {
    animation-delay: 0.12s;
  }
  .hero__lede {
    margin-top: 26px;
    max-width: 56ch;
    animation: rise 1s var(--ease) 0.3s both;
  }
  .hero__cta {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 12px;
    margin-top: 34px;
    animation: rise 1s var(--ease) 0.42s both;
  }

  .hero__hud-wrap {
    padding-bottom: clamp(20px, 4vh, 44px);
    animation: rise 1.1s var(--ease) 0.6s both;
  }
  .hero__hud {
    display: grid;
    grid-template-columns: repeat(3, auto) 1fr;
    margin: 0;
    border-radius: 18px;
    overflow: hidden;
  }
  .hero__hud > div {
    padding: 16px 26px;
    border-right: 1px solid var(--line);
  }
  .hero__hud > div:last-child {
    border-right: 0;
  }
  .hero__hud dt {
    font-family: var(--font-mono);
    font-size: 0.64rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .hero__hud dd {
    margin: 4px 0 0;
    font-family: var(--font-display);
    font-size: 1.7rem;
    font-weight: 300;
    letter-spacing: -0.03em;
    line-height: 1.1;
  }
  .hero__hud small {
    font-family: var(--font-mono);
    font-size: 0.62rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ev-estimate);
    margin-left: 4px;
  }
  .hero__hud .hero__hud-text {
    font-size: 1.02rem;
    font-weight: 400;
    letter-spacing: -0.01em;
    color: var(--ink-soft);
    padding-top: 5px;
  }

  @keyframes rise {
    from {
      opacity: 0;
      transform: translateY(18px);
    }
  }
  @keyframes wipe {
    from {
      transform: translateY(105%);
    }
  }

  @media (max-width: 900px) {
    .hero__hud {
      grid-template-columns: repeat(3, 1fr);
    }
    .hero__hud-model {
      grid-column: 1 / -1;
      border-top: 1px solid var(--line);
    }
    .hero__hud > div:nth-child(3) {
      border-right: 0;
    }
    .hero__hud > div {
      padding: 14px 16px;
    }
    .hero__hud dd {
      font-size: 1.4rem;
    }
  }
  @media (max-width: 1000px) {
    .sky {
      display: none;
    }
  }
  @media (max-width: 760px) {
    .hero__labels {
      display: none;
    }
    .hero__cta .btn {
      width: 100%;
    }
    .hero__cta {
      width: 100%;
    }
  }
  @media (max-width: 420px) {
    .hero__hud small {
      display: block;
      margin: 2px 0 0;
    }
  }
</style>
