---
/**
 * Generated illustration of what a template does. These are diagrams drawn in
 * SVG, deliberately abstract: they are not screenshots of a finished product.
 */
import type { Template } from '../data/types';
interface Props {
  kind: Template['preview'];
  hue: number;
}
const { kind, hue } = Astro.props;
const c = `hsl(${hue} 90% 68%)`;
const c2 = `hsl(${(hue + 40) % 360} 85% 72%)`;
---

<div class="tprev" style={`--c:${c}; --c2:${c2}`} aria-hidden="true">
  <svg viewBox="0 0 320 180" preserveAspectRatio="xMidYMid slice">
    <defs>
      <radialGradient id={`g-${kind}-${hue}`} cx="30%" cy="20%" r="90%">
        <stop offset="0" stop-color={c} stop-opacity=".28"></stop>
        <stop offset="1" stop-color="#05060b" stop-opacity="0"></stop>
      </radialGradient>
    </defs>
    <rect width="320" height="180" fill="#070912"></rect>
    <rect width="320" height="180" fill={`url(#g-${kind}-${hue})`}></rect>

    {
      kind === 'timeline' && (
        <g>
          <line x1="30" y1="96" x2="290" y2="96" stroke="#fff" stroke-opacity=".2" />
          <line class="draw" x1="30" y1="96" x2="210" y2="96" stroke={c} stroke-width="2" />
          {[50, 110, 170, 230].map((x, i) => (
            <g>
              <circle cx={x} cy="96" r="5" fill={i < 3 ? c : '#1a2036'} stroke={c} />
              <rect x={x - 22} y={i % 2 ? 110 : 54} width="44" height="26" rx="4" fill="#fff" fill-opacity=".06" stroke="#fff" stroke-opacity=".14" />
              <rect x={x - 16} y={i % 2 ? 117 : 61} width="24" height="3" rx="1.5" fill="#fff" fill-opacity=".6" />
              <rect x={x - 16} y={i % 2 ? 124 : 68} width="32" height="2" rx="1" fill="#fff" fill-opacity=".25" />
            </g>
          ))}
        </g>
      )
    }
    {
      kind === 'lowerthird' && (
        <g>
          <rect x="24" y="24" width="272" height="132" rx="6" fill="#fff" fill-opacity=".03" stroke="#fff" stroke-opacity=".08" />
          <g class="slide">
            <rect x="36" y="112" width="4" height="32" fill={c} />
            <rect x="46" y="112" width="150" height="32" rx="3" fill="#0b1022" stroke={c} stroke-opacity=".5" />
            <rect x="56" y="120" width="92" height="5" rx="2.5" fill="#fff" fill-opacity=".85" />
            <rect x="56" y="131" width="126" height="3" rx="1.5" fill={c2} fill-opacity=".7" />
          </g>
        </g>
      )
    }
    {
      kind === 'map' && (
        <g>
          <path d="M40 60q30-22 62-6t50 0 52 10 60-8v70q-34 14-64 4t-52 6-56-8-52 6Z" fill="#fff" fill-opacity=".04" stroke="#fff" stroke-opacity=".14" />
          <path class="draw" d="M62 112C96 60 150 130 196 84s52-18 66-22" fill="none" stroke={c} stroke-width="2" stroke-dasharray="5 5" />
          <circle cx="62" cy="112" r="4.500" fill={c} />
          <circle cx="262" cy="62" r="4.500" fill={c2} />
          <circle class="ping" cx="262" cy="62" r="10" fill="none" stroke={c2} />
        </g>
      )
    }
    {
      kind === 'docu' && (
        <g>
          <g class="drift">
            <rect x="60" y="30" width="130" height="104" rx="3" fill="#fff" fill-opacity=".07" stroke="#fff" stroke-opacity=".3" transform="rotate(-4 125 82)" />
            <rect x="140" y="44" width="124" height="96" rx="3" fill="#0d1226" stroke={c} stroke-opacity=".6" transform="rotate(3 202 92)" />
            <path d="M150 124l28-34 20 22 14-12 42 26Z" fill={c} fill-opacity=".25" transform="rotate(3 202 92)" />
          </g>
          <rect x="60" y="152" width="96" height="3" rx="1.500" fill="#fff" fill-opacity=".35" />
        </g>
      )
    }
    {
      kind === 'counter' && (
        <g>
          <path d="M70 130a90 90 0 0 1 180 0" fill="none" stroke="#fff" stroke-opacity=".12" stroke-width="10" stroke-linecap="round" />
          <path class="draw" d="M70 130a90 90 0 0 1 150-66" fill="none" stroke={c} stroke-width="10" stroke-linecap="round" />
          <rect x="128" y="96" width="64" height="20" rx="4" fill="#fff" fill-opacity=".85" />
          <rect x="140" y="124" width="40" height="4" rx="2" fill={c2} fill-opacity=".7" />
        </g>
      )
    }
    {
      kind === 'split' && (
        <g>
          <rect x="34" y="26" width="6" height="128" rx="3" fill="#fff" fill-opacity=".1" />
          <rect class="grow" x="34" y="26" width="6" height="128" rx="3" fill={c} />
          {[0, 1, 2, 3].map((i) => (
            <g>
              <rect x="56" y={26 + i * 33} width={230 - i * 26} height="26" rx="5" fill={i === 1 ? c : '#fff'} fill-opacity={i === 1 ? 0.22 : 0.05} stroke={i === 1 ? c : '#fff'} stroke-opacity={i === 1 ? 0.8 : 0.14} />
              <rect x="68" y={37 + i * 33} width={70 - i * 6} height="4" rx="2" fill="#fff" fill-opacity=".7" />
            </g>
          ))}
        </g>
      )
    }
    {
      kind === 'caption' && (
        <g>
          <rect x="116" y="14" width="88" height="152" rx="10" fill="#0b1022" stroke="#fff" stroke-opacity=".2" />
          <rect x="126" y="100" width="34" height="12" rx="3" fill={c} />
          <rect x="164" y="100" width="30" height="12" rx="3" fill="#fff" fill-opacity=".85" />
          <rect class="blink" x="126" y="117" width="48" height="12" rx="3" fill="#fff" fill-opacity=".85" />
          <rect x="126" y="24" width="68" height="4" rx="2" fill="#fff" fill-opacity=".14" />
        </g>
      )
    }
    {
      kind === 'chart' && (
        <g>
          <path d="M40 30v120h250" fill="none" stroke="#fff" stroke-opacity=".2" />
          {[60, 90, 120].map((y) => <line x1="40" x2="290" y1={y} y2={y} stroke="#fff" stroke-opacity=".06" />)}
          <path d="M40 132l40-18 36 8 40-40 38 14 40-46 50-12v112H40Z" fill={c} fill-opacity=".12" />
          <path class="draw" d="M40 132l40-18 36 8 40-40 38 14 40-46 50-12" fill="none" stroke={c} stroke-width="2.200" />
          <circle cx="234" cy="50" r="4" fill={c2} />
          <rect x="40" y="160" width="70" height="3" rx="1.500" fill="#fff" fill-opacity=".3" />
        </g>
      )
    }
    {
      kind === 'title' && (
        <g>
          <rect class="sweep" x="-80" y="0" width="80" height="180" fill="#fff" fill-opacity=".05" transform="skewX(-20)" />
          <rect x="90" y="74" width="140" height="10" rx="2" fill="#fff" fill-opacity=".9" />
          <rect x="120" y="94" width="80" height="4" rx="2" fill={c} />
          <line x1="60" x2="260" y1="60" y2="60" stroke="#fff" stroke-opacity=".15" />
          <line x1="60" x2="260" y1="112" y2="112" stroke="#fff" stroke-opacity=".15" />
        </g>
      )
    }
  </svg>
  <span class="tprev__tag">Illustration</span>
</div>

<style>
  .tprev {
    position: relative;
    aspect-ratio: 16 / 9;
    border-radius: 14px;
    overflow: hidden;
    border: 1px solid var(--line);
    background: #070912;
  }
  .tprev svg {
    width: 100%;
    height: 100%;
  }
  .tprev__tag {
    position: absolute;
    right: 10px;
    bottom: 8px;
    font-family: var(--font-mono);
    font-size: 0.58rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.4);
  }
  .tprev :global(.draw) {
    stroke-dasharray: 600;
    stroke-dashoffset: 600;
    animation: draw 3.6s var(--ease) infinite;
  }
  .tprev :global(path.draw[stroke-dasharray='5 5']) {
    stroke-dasharray: 5 5;
    stroke-dashoffset: 0;
    animation: march 1.2s linear infinite;
  }
  .tprev :global(.slide) {
    animation: slide 3.6s var(--ease) infinite;
  }
  .tprev :global(.ping) {
    transform-origin: 262px 62px;
    animation: ping 2s ease-out infinite;
  }
  .tprev :global(.drift) {
    animation: drift 7s ease-in-out infinite alternate;
  }
  .tprev :global(.grow) {
    transform-origin: 37px 154px;
    animation: grow 3.6s var(--ease) infinite;
  }
  .tprev :global(.blink) {
    animation: blink 1.4s steps(2) infinite;
  }
  .tprev :global(.sweep) {
    animation: sweep 4s ease-in-out infinite;
  }
  @keyframes draw {
    0% {
      stroke-dashoffset: 600;
    }
    55%,
    100% {
      stroke-dashoffset: 0;
    }
  }
  @keyframes march {
    to {
      stroke-dashoffset: -20;
    }
  }
  @keyframes slide {
    0% {
      transform: translateX(-60px);
      opacity: 0;
    }
    25%,
    80% {
      transform: none;
      opacity: 1;
    }
    100% {
      transform: translateX(-20px);
      opacity: 0;
    }
  }
  @keyframes ping {
    from {
      transform: scale(0.4);
      opacity: 1;
    }
    to {
      transform: scale(1.8);
      opacity: 0;
    }
  }
  @keyframes drift {
    to {
      transform: translate(-8px, -4px) scale(1.04);
    }
  }
  @keyframes grow {
    0% {
      transform: scaleY(0);
    }
    60%,
    100% {
      transform: scaleY(0.55);
    }
  }
  @keyframes blink {
    50% {
      opacity: 0.25;
    }
  }
  @keyframes sweep {
    to {
      transform: skewX(-20deg) translateX(520px);
    }
  }
</style>
